# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: only the example is committed
!.env.example

# local data (dev database, media)
/.pglite/
/.data/
/eval-results/

# owner photo fixtures are private by default (repo is public); synthetic fixtures are committed.
# Case-insensitive on purpose: iPhone exports are IMG_0001.JPG, and git matches case by default.
/fixtures/**/*.[jJ][pP][gG]
/fixtures/**/*.[jJ][pP][eE][gG]
/fixtures/**/*.[pP][nN][gG]
/fixtures/**/*.[hH][eE][iI][cCfF]
/fixtures/**/*.[hH][eE][iI][cCfF][sS]
/fixtures/**/*.[wW][eE][bB][pP]
/fixtures/**/*.[gG][iI][fF]
/fixtures/**/*.[aA][vV][iI][fF]
/fixtures/**/*.[tT][iI][fF]
/fixtures/**/*.[tT][iI][fF][fF]
/fixtures/**/*.[dD][nN][gG]
/fixtures/**/*.[mM][oO][vV]
!/fixtures/synthetic/**
