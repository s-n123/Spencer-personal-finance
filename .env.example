# Copy to .env.local and fill in. Never commit real values (the repo is public).
# Only secrets and deployment wiring live here; product tunables are in src/server/config/policy.ts.
# A test keeps this file's keys identical to the schema in src/server/config/env.ts.

# --- Anthropic ---------------------------------------------------------------
# Needed when LLM_PROVIDER=anthropic. Get one at https://platform.claude.com.
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
# low | medium | high (kept constant within a turn)
MODEL_MAIN_EFFORT=medium
# anthropic = call the API. fake = a deterministic offline demo model that describes what it
# received (photo count, sizes) without a key or network (D-120).
LLM_PROVIDER=anthropic
# Server-side refusal fallback (beta): default | off. See DECISIONS D-038.
ANTHROPIC_FALLBACKS=default

# --- Database ----------------------------------------------------------------
# Default: the PGlite dev server that `npm run dev` starts on 127.0.0.1:54330 (data in .pglite/).
# Any Postgres 16+ works too.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/postgres
# Direct (non-pooled) URL for migrations; empty = use DATABASE_URL. Neon injects both on Vercel.
DATABASE_URL_UNPOOLED=
# Server for `npm run test:pg` (it creates and drops its own databases). Empty = start a
# throwaway local Postgres 16 from installed binaries.
TEST_DATABASE_URL=

# --- Simulator (/dev/chat) ---------------------------------------------------
# Always off on a production deployment (VERCEL_ENV=production), whatever this says.
ENABLE_SIMULATOR=true

# --- Media -------------------------------------------------------------------
# local = files under MEDIA_LOCAL_DIR (dev). vercel-blob = private Vercel Blob (M6).
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=.data/media

# --- App wiring --------------------------------------------------------------
# Used until the user tells the coach their timezone (the simulator sends the browser's zone).
DEFAULT_TIMEZONE=America/New_York
# Public base URL plus a random secret of at least 32 characters (e.g. `openssl rand -hex 32`)
# enable self-handoff via /api/internal/kick when an invocation runs low on time (needed on
# Vercel). Leave both empty in local dev.
APP_BASE_URL=
INTERNAL_KICK_SECRET=
# debug | info | warn | error (debug is refused in production)
LOG_LEVEL=info
